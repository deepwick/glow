{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#D4D4D4", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#7A86A8", "italic": true },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#569CD6", "bold": true },
  "h1": { "prefix": " ", "suffix": " ", "color": "#04041a", "background_color": "#569CD6", "bold": true },
  "h2": { "prefix": "## " },
  "h3": { "prefix": "### " },
  "h4": { "prefix": "#### " },
  "h5": { "prefix": "##### " },
  "h6": { "prefix": "###### ", "bold": false },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true },
  "hr": { "color": "#6E7899", "format": "\n--------\n" },
  "item": { "block_prefix": "• " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#CE9178", "underline": true },
  "link_text": { "color": "#CE9178", "bold": true },
  "image": { "color": "#CE9178", "underline": true },
  "image_text": { "color": "#7A86A8", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#CE9178", "background_color": "#10192C" },
  "code_block": {
    "color": "#D4D4D4",
    "margin": 2,
    "chroma": {
      "text": { "color": "#D4D4D4" },
      "error": { "color": "#F44747" },
      "comment": { "color": "#7A86A8", "italic": true },
      "comment_preproc": { "color": "#6E7899", "bold": true },
      "keyword": { "color": "#569CD6" },
      "keyword_reserved": { "color": "#C586C0" },
      "keyword_namespace": { "color": "#C586C0" },
      "keyword_type": { "color": "#4EC9B0" },
      "operator": { "color": "#D4D4D4" },
      "punctuation": { "color": "#D4D4D4" },
      "name": { "color": "#9CDCFE" },
      "name_builtin": { "color": "#DCDCAA" },
      "name_tag": { "color": "#569CD6" },
      "name_attribute": { "color": "#9CDCFE" },
      "name_class": { "color": "#4EC9B0" },
      "name_constant": { "color": "#4FC1FF" },
      "name_decorator": { "color": "#DCDCAA" },
      "name_exception": { "color": "#4EC9B0" },
      "name_function": { "color": "#DCDCAA" },
      "name_other": { "color": "#9CDCFE" },
      "literal": {},
      "literal_number": { "color": "#B5CEA8" },
      "literal_date": {},
      "literal_string": { "color": "#CE9178" },
      "literal_string_escape": { "color": "#D7BA7D" },
      "generic_deleted": { "color": "#F44747" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#57A64A" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#569CD6" },
      "background": { "background_color": "#10192C" }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n🠶 " },
  "html_block": {},
  "html_span": {}
}
